*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local Python environments and environment settings.
.venv/
venv/
env/
.env/
.env
.env.*
!.env.example

# Editor-local settings.
.vscode/
